# ---------------------------------------------------------------------------
# Prime Nation Haul — environment configuration
# Copy to .env.local for local development. Never commit real secrets.
# ---------------------------------------------------------------------------

# Resend API key (server only). Create at https://resend.com/api-keys
RESEND_API_KEY=

# Destination inbox for all website form notifications.
CONTACT_TO_EMAIL=

# Verified sender identity on your Resend-verified domain.
# Example: Prime Nation Haul <notifications@yourdomain.com>
CONTACT_FROM_EMAIL=

# Optional public-facing email shown in the header/footer/contact page.
# Leave blank if no public address has been approved.
NEXT_PUBLIC_CONTACT_EMAIL=

# Canonical production URL (no trailing slash). Used for metadata, sitemap,
# robots.txt, canonicals, and structured data.
NEXT_PUBLIC_SITE_URL=https://www.primenationhaul.com

# Optional Google Analytics 4 measurement ID (G-XXXXXXXXXX).
# Analytics only loads after a visitor grants consent.
NEXT_PUBLIC_GA_ID=
